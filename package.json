{
  "name": "package-lens-hyperdart",
  "version": "1.0.0",
  "description": "Live npm package details, comparisons and transparent alternatives for HyperDart",
  "type": "module",
  "private": false,
  "source": "src/frontend/index.jsx",
  "module": "dist/frontend/index.modern.js",
  "main": "dist/frontend/index.modern.js",
  "umdName": "HDPackageLens",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "validate": "node scripts/validate-publish.js",
    "prepublishOnly": "npm run build && npm run validate"
  },
  "files": ["hyperdart.config.js", "dist/frontend", "resource.json", "README.md"],
  "publishConfig": {"registry": "https://dev-registry.hyperdart.com"},
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hyperdart/frontend": "2.0.14",
    "@mui/material": "^6.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@hyperdart/backend": "2.0.5",
    "@hyperdart/sandbox": "2.0.11",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.0",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
